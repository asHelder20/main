# SSID de sessão do Pocket Option.
# Como obter: faça login em pocketoption.com no navegador, abra o DevTools
# (F12) > Application > Cookies > https://pocketoption.com > copie o valor
# do cookie "ssid" (ou capture a mensagem de auth na aba Network > WS).
# NUNCA compartilhe este valor - ele dá acesso total à sua conta.
PO_SSID=

# true = conta demo, false = conta REAL (dinheiro de verdade).
# O tipo de conta real vem do próprio SSID copiado (demo ou real);
# esta variável é só para os avisos e travas de segurança do bot.
PO_DEMO=false

# Trava obrigatória: com PO_DEMO=false, o bot só liga se isto for true.
# Só mude para true depois de validar a estratégia em conta demo.
LIVE_TRADING_CONFIRMED=false

# Pares monitorados. O bot analisa todos em tempo real a cada ciclo e
# escolhe automaticamente o de melhor sinal (se algum ultrapassar o score
# mínimo). Pares _otc negociam 24/7, por isso são o padrão.
PO_PAIRS=EURUSD_otc,GBPUSD_otc,USDJPY_otc,EURJPY_otc,AUDCAD_otc,USDCHF_otc,NZDUSD_otc,EURGBP_otc

# Timeframe dos candles em segundos (opções aceitas pela corretora: 1,5,15,30,60,300)
CANDLE_PERIOD_SECONDS=60
# Quantos candles fechados manter em memória por par
HISTORY_SIZE=100

# Duração desejada de cada operação, em segundos (ex.: 60 = M1, 180 = M3,
# 300 = M5). Cada ativo só aceita um conjunto fixo de durações na Pocket
# Option (ex.: 5/15/30/60/180/300...) - o bot consulta isso na corretora ao
# conectar e ajusta automaticamente para a duração válida mais próxima,
# por par, avisando no log quando isso acontece.
EXPIRY_SECONDS=60
STAKE_AMOUNT=1.0

# A cada quantos segundos o bot reavalia todos os pares e decide se entra
DECISION_INTERVAL_SECONDS=15
# Score mínimo (0-1) de confiança do sinal para o bot operar
MIN_SIGNAL_SCORE=0.35

# Parâmetros da estratégia (Parabolic SAR / RSI / Bandas de Bollinger)
# PSAR: passo e teto do fator de aceleração (valores padrão do indicador)
PSAR_AF_STEP=0.02
PSAR_AF_MAX=0.2
RSI_PERIOD=14
RSI_LOWER=30
RSI_UPPER=70
BB_PERIOD=20
BB_STD_MULT=2.0
MIN_BB_WIDTH=0.0006

# Gestão de risco
MAX_DAILY_LOSS=20.0
MAX_TRADES_PER_DAY=20
MAX_CONCURRENT_TRADES=1
COOLDOWN_AFTER_LOSS_SECONDS=60

JOURNAL_PATH=trade_journal.csv
